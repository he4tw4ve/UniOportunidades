# Server only. Leave the three connection/Auth values empty to inspect the public UI.
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Empty means no trusted proxy. Set only known proxy IPs/CIDRs, comma separated.
# The proxy must overwrite forwarded headers; do not use true, hop counts or /0.
TRUST_PROXY=
# Copy a PostgreSQL URL locally. Outside localhost sslmode=verify-full is required.
# Add sslrootcert pointing to the official CA if your connection requires it.
DATABASE_URL=
SUPABASE_URL=
# Publishable (or legacy anon) key only. This is NOT the privileged secret key.
SUPABASE_ANON_KEY=
# Used only by explicit seed provisioning; leave empty during normal operation.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_SEED_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=
DEMO_PUBLISHER_PASSWORD=
